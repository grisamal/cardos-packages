#!lua
-- fastfetch: CardOS / Arch Linux System Information Tool

local LOGO = {
  "      /\\       ",
  "     /  \\      ",
  "    /\\   \\     ",
  "   /      \\    ",
  "  /   ,,   \\   ",
  " /   |  |  -\\  ",
  "/_-''    ''-_\\ ",
}
local LOGO_WIDTH = 15

local function uptimeText()
  local s = math.floor(sys.uptime())
  return string.format("%dh %02dm %02ds", s // 3600, (s // 60) % 60, s % 60)
end

local function bytesText(n)
  if n >= 1000000000 then return string.format("%.1f GB", n / 1000000000) end
  if n >= 1000000 then return string.format("%.1f MB", n / 1000000) end
  return string.format("%d KB", n // 1000)
end

local user = (sys.user and sys.user()) or "user"
local host = (sys.hostname and sys.hostname()) or "cardos"
local model, cores, mhz = sys.chip()
local free, total, psram = sys.heap()
local pct, mv, charging = sys.battery()
local sdTotal, sdUsed = sys.sd()
local packages = fs.list("/usr/local/bin") or {}

local info = {
  { "", user .. "@" .. host, "white" },
  { "", string.rep("-", #user + #host + 1), "dim" },
  { "OS", "CardOS 2026.10-arch" },
  { "Host", "M5Stack Cardputer ADV" },
  { "Kernel", "CardOS Unix v" .. sys.version() },
  { "Uptime", uptimeText() },
  { "CPU", string.format("%s (%d cores @ %dMHz)", model, cores, mhz) },
  { "Memory", string.format("%d KB / %d KB free", free, total) },
  { "Storage", sdTotal and (bytesText(sdUsed) .. " / " .. bytesText(sdTotal)) or "MicroSD" },
  { "Battery", string.format("%d%% (%d mV%s)", pct, mv, charging and ", charging" or "") },
  { "Network", net.connected() and (net.ssid() .. " (" .. net.ip() .. ")") or "Disconnected" },
  { "Packages", #packages .. " (pacman)" },
}

local rows = math.max(#LOGO, #info)
for i = 1, rows do
  local logo = LOGO[i] or string.rep(" ", LOGO_WIDTH)
  term.write(logo .. "  ", "cyan")
  local line = info[i]
  if line then
    if line[1] == "" then
      term.print(line[2], line[3])
    else
      term.write(string.format("%-9s", line[1] .. ":"), "cyan")
      term.print(line[2], "text")
    end
  else
    term.print("", "text")
  end
end
term.flush()
