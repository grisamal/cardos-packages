#!lua
-- pacman: Arch Linux package manager for CardOS
-- Repository: https://github.com/grisamal/cardos-packages

local REPO_BASE = "https://raw.githubusercontent.com/grisamal/cardos-packages/main"
local DB_PATH = "/sys/pacman/packages.json"
local INSTALLED_PATH = "/sys/pacman/installed.txt"
local INSTALL_DIR = "/usr/local/bin"

local function readLine()
  local str = ""
  while true do
    local k = key.poll()
    if k then
      if k == "enter" then
        term.print("", "text")
        return str
      elseif k == "backspace" then
        if #str > 0 then
          str = str:sub(1, #str - 1)
          term.write("\b \b", "text")
        end
      elseif #k == 1 then
        str = str .. k
        term.write(k, "white")
      end
    end
    sys.sleep(10)
  end
end

local function parseJson(str)
  local pkgs = {}
  for block in str:gmatch("{(.-)}") do
    local name = block:match('"name"%s*:%s*"([^"]+)"')
    local ver = block:match('"version"%s*:%s*"([^"]+)"')
    local desc = block:match('"description"%s*:%s*"([^"]+)"')
    local sha = block:match('"sha256"%s*:%s*"([^"]+)"')
    local file = block:match('"file"%s*:%s*"([^"]+)"')
    local ptype = block:match('"type"%s*:%s*"([^"]+)"')
    local size = tonumber(block:match('"size"%s*:%s*(%d+)')) or 0
    if name then
      table.insert(pkgs, {
        name = name, version = ver or "1.0", description = desc or "",
        sha256 = sha or "", file = file or ("bin/" .. name), type = ptype or "script", size = size
      })
    end
  end
  return { packages = pkgs }
end

local function loadDb()
  if not fs.exists(DB_PATH) then return nil end
  local c = fs.read(DB_PATH)
  if not c then return nil end
  return parseJson(c)
end

local function loadInstalled()
  if not fs.exists(INSTALLED_PATH) then return {} end
  local c = fs.read(INSTALLED_PATH) or ""
  local res = {}
  for line in c:gmatch("[^\r\n]+") do
    local n, v = line:match("^(%S+)%s+(%S+)")
    if n then res[n] = v end
  end
  return res
end

local function saveInstalled(inst)
  local lines = {}
  for n, v in pairs(inst) do
    table.insert(lines, n .. " " .. v)
  end
  table.sort(lines)
  fs.write(INSTALLED_PATH, table.concat(lines, "\n") .. "\n")
end

local function fetchUrl(url)
  if not net or not net.get then return nil end
  local status, body = net.get(url)
  if status == 200 and type(body) == "string" and #body > 0 then
    return body
  elseif type(status) == "string" and #status > 0 and (not body or body == "") then
    return status
  end
  return nil
end

local function syncDb()
  term.print(":: Synchronizing package databases...", "cyan")
  term.write("   grisamal [", "text")
  local url = REPO_BASE .. "/packages.json"
  local data = fetchUrl(url)
  if not data or #data < 10 then
    term.print("FAILED]", "red")
    term.print("error: failed to synchronize database (check WiFi connection)", "red")
    return false
  end
  if not fs.exists("/sys/pacman") then
    -- Directory exists on SD
  end
  fs.write(DB_PATH, data)
  term.print("####################] 100%", "green")
  local db = parseJson(data)
  local count = #(db.packages or {})
  term.print(string.format(":: Database updated: %d packages available.", count), "white")
  return true
end

local function searchDb(query)
  local db = loadDb()
  if not db then
    term.print("error: database not found. Run 'pacman -Sy' first.", "red")
    return
  end
  query = (query or ""):lower()
  local found = 0
  for _, p in ipairs(db.packages or {}) do
    if query == "" or p.name:lower():find(query, 1, true) or (p.description or ""):lower():find(query, 1, true) then
      term.print(string.format("core/%s %s", p.name, p.version), "magenta")
      term.print("    " .. (p.description or "No description"), "text")
      found = found + 1
    end
  end
  if found == 0 then
    term.print("no packages matched query", "yellow")
  end
end

local function installPkg(pkgName)
  local db = loadDb()
  if not db then
    term.print("error: database not found. Run 'pacman -Sy' first.", "red")
    return
  end
  local target = nil
  for _, p in ipairs(db.packages or {}) do
    if p.name == pkgName then target = p; break end
  end
  if not target then
    term.print("error: target not found: " .. pkgName, "red")
    return
  end

  term.print(string.format("Packages (1) %s-%s", target.name, target.version), "white")
  term.print(string.format("Total Download Size:   %.2f KiB", (target.size or 1024) / 1024), "dim")
  term.print(string.format("Install Destination:   %s/%s", INSTALL_DIR, target.name), "dim")
  term.write(":: Proceed with installation? [Y/n] ", "prompt")
  local ans = readLine()
  if ans ~= "" and ans:lower() ~= "y" then
    term.print("error: operation aborted by user", "red")
    return
  end

  term.print(":: Retrieving packages...", "cyan")
  local fileUrl = REPO_BASE .. "/" .. (target.file or ("bin/" .. target.name))
  local data = fetchUrl(fileUrl)
  if not data or #data == 0 then
    term.print("error: failed to retrieve " .. fileUrl, "red")
    return
  end

  local outPath = INSTALL_DIR .. "/" .. target.name
  local ok, err = fs.write(outPath, data)
  if not ok then
    term.print("error: failed to write " .. outPath .. " (" .. tostring(err) .. ")", "red")
    return
  end

  local inst = loadInstalled()
  inst[target.name] = target.version
  saveInstalled(inst)

  term.print(string.format("(1/1) installing %-16s [####################] 100%%", target.name), "green")
  term.print(":: Package installed successfully to " .. outPath, "green")
end

local function removePkg(pkgName)
  local inst = loadInstalled()
  if not inst[pkgName] then
    term.print("error: target not found: " .. pkgName, "red")
    return
  end
  term.write(string.format(":: Remove package %s? [Y/n] ", pkgName), "prompt")
  local ans = readLine()
  if ans ~= "" and ans:lower() ~= "y" then return end

  local outPath = INSTALL_DIR .. "/" .. pkgName
  fs.remove(outPath)
  inst[pkgName] = nil
  saveInstalled(inst)
  term.print(string.format("(1/1) removing %-18s [####################] 100%%", pkgName), "yellow")
end

local function listInstalled()
  local inst = loadInstalled()
  local count = 0
  for n, v in pairs(inst) do
    term.print(string.format("%-18s %s", n, v), "green")
    count = count + 1
  end
  if count == 0 then
    term.print("No packages recorded in installed database.", "yellow")
  end
end

-- CLI Entrypoint
local args = arg or {}
if #args == 0 or args[1] == "-h" or args[1] == "--help" then
  term.print("CardOS Package Manager (pacman v2026.10)", "cyan")
  term.print("usage:  pacman <operation> [targets]", "white")
  term.print("operations:", "yellow")
  term.print("  pacman -Sy            sync package database with GitHub", "text")
  term.print("  pacman -S <pkg>       install package(s)", "text")
  term.print("  pacman -R <pkg>       remove package(s)", "text")
  term.print("  pacman -Ss <query>    search remote package database", "text")
  term.print("  pacman -Q             list installed packages", "text")
  term.print("  pacman -Syu           full system upgrade", "text")
  return
end

local op = args[1]
if op == "-Sy" then
  syncDb()
elseif op == "-Syu" then
  if syncDb() then
    term.print(":: Starting full system upgrade...", "cyan")
    term.print(":: All local packages are up to date.", "green")
  end
elseif op == "-Ss" then
  searchDb(args[2] or "")
elseif op == "-S" then
  if not args[2] then term.print("error: no targets specified", "red"); return end
  for i = 2, #args do installPkg(args[i]) end
elseif op == "-R" then
  if not args[2] then term.print("error: no targets specified", "red"); return end
  for i = 2, #args do removePkg(args[i]) end
elseif op == "-Q" then
  listInstalled()
else
  term.print("pacman: unrecognized option '" .. op .. "'", "red")
end
