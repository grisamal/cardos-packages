#!lua
-- gpsview: shows the position from a GPS module on Grove port / UART.
-- Cardputer ADV Grove connector: Pin 1 (G1 = RX), Pin 2 (G2 = TX).

local rx = tonumber(arg and arg[1] or "") or 1
local tx = tonumber(arg and arg[2] or "") or 2
local baud = tonumber(arg and arg[3] or "") or 9600

if not uart or not driver then
  term.print("gpsview: UART driver not available in this kernel", "red")
  sys.sleep(2000)
  return
end

local gps, gerr = driver.load("gps")
if not gps then
  term.print("gpsview driver error: " .. tostring(gerr), "red")
  sys.sleep(2000)
  return
end

local port, perr = uart.open{ rx = rx, tx = tx, baud = math.floor(baud) }
if not port then
  term.print(string.format("gpsview: failed to open UART on G%d/G%d: %s", rx, tx, tostring(perr)), "red")
  sys.sleep(2500)
  return
end

local COLS, ROWS = term.size()

local function draw(fix)
  term.clear()
  term.print("CardOS GPS Live Monitor (Grove G1/G2 @ " .. baud .. ")", "cyan")
  term.print(string.rep("-", 40), "dim")
  term.print("")
  if fix.lat and fix.lon then
    term.print(string.format("  Latitude:   \27[1;32m%.6f\27[0m", fix.lat), "white")
    term.print(string.format("  Longitude:  \27[1;32m%.6f\27[0m", fix.lon), "white")
  else
    term.print("  Position:   Searching satellites...", "yellow")
    term.print("  (Needs direct view of the sky)", "dim")
  end
  term.print("")
  term.print(string.format("  Satellites: %s   Fix Quality: %s", tostring(fix.sats or "-"), tostring(fix.quality or "-")), "text")
  term.print(string.format("  Altitude:   %s", fix.alt and string.format("%.1f m", fix.alt) or "-"), "text")
  term.print(string.format("  Speed:      %s", fix.speed and string.format("%.1f km/h", fix.speed) or "-"), "text")
  term.print(string.format("  Time (UTC): %s", fix.time or "-"), "text")
  term.print("")
  term.print("Press 'q' or 'Ctrl+C' to exit", "dim")
  term.flush()
end

local reader = gps.new(port)

while true do
  local fix = reader:poll()
  if fix then draw(fix) end
  local k = key.poll()
  if k == "q" or k == "ctrl-q" or k == "esc" then break end
  sys.sleep(100)
end

port:close()
term.clear()
